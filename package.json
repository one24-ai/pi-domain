{
  "name": "pi-recall",
  "version": "0.1.0",
  "description": "Persistent memory for pi: a local SQLite store with tools for the model, a short budgeted recall at the start of each session, compaction summaries kept as searchable notes, daily snapshots, and optional pi-halo rows and sidebar.",
  "type": "module",
  "license": "MIT",
  "author": "Zach Koncir <zach@one24.ai>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/one24-ai/pi-recall.git"
  },
  "homepage": "https://github.com/one24-ai/pi-recall#readme",
  "bugs": {
    "url": "https://github.com/one24-ai/pi-recall/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "memory",
    "sqlite",
    "coding-agent"
  ],
  "pi": {
    "extensions": [
      "./extensions/recall/index.ts"
    ]
  },
  "files": [
    "extensions",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node scripts/link-pi.mjs && node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "typecheck": "node scripts/link-pi.mjs && tsc --noEmit",
    "check": "pnpm test && pnpm typecheck"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
